# Commands run by the launchd job com.hackios.demo (see com.hackios.demo.plist).
# Text in scripts other than Latin: font_test says which font the system font falls back to for emoji, Chinese,
# Japanese and Korean and how many pixels drawing them paints (and in colour); then, with wifi=1, Safari opens the
# Chinese Wikipedia and a page of emoji as text, for screenshots.
/hackios/bin/sound_test springboard
/hackios/bin/rwtouch wait 10
/hackios/bin/font_test
/hackios/bin/battery_test open https://zh.m.wikipedia.org/
/hackios/bin/rwtouch wait 25
/hackios/bin/battery_test open https://getemoji.com/
/hackios/bin/rwtouch wait 25
