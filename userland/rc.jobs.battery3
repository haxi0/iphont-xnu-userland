# Commands run by the launchd job com.hackios.demo (see com.hackios.demo.plist).
# An hour of use before Settings > Battery is opened (with adsp=1): applications opened in turn -- Settings, Notes,
# Calendar -- so that the power log has an hour of their use to show; then the battery page, scrolled, and Battery
# Health & Charging, for screenshots; at the end what the power log has collected (battery_test powerlog).
/hackios/bin/sound_test springboard
/hackios/bin/rwtouch wait 20
/hackios/bin/battery_test open prefs:root=General
/hackios/bin/rwtouch wait 600
/hackios/bin/battery_test open mobilenotes://
/hackios/bin/rwtouch wait 600
/hackios/bin/battery_test open calshow://
/hackios/bin/rwtouch wait 600
/hackios/bin/battery_test open prefs:root=DISPLAY
/hackios/bin/rwtouch wait 600
/hackios/bin/battery_test open mobilenotes://
/hackios/bin/rwtouch wait 600
/hackios/bin/battery_test open calshow://
/hackios/bin/rwtouch wait 600
/hackios/bin/battery_test open prefs:root=BATTERY_USAGE
/hackios/bin/rwtouch wait 15 drag 0.5 0.85 0.5 0.35 1500 400 wait 4 drag 0.5 0.85 0.5 0.35 1500 400 wait 6
/hackios/bin/battery_test open prefs:root=BATTERY_USAGE&path=BATTERY_HEALTH
/hackios/bin/rwtouch wait 10
/hackios/bin/battery_test powerlog
