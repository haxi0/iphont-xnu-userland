# Commands run by the launchd job com.hackios.demo (RC_JOBS=rc.jobs.metalall).
#
# Every compute kernel of the corpus that tools/air/kstruct.py did not measure as unable to
# terminate -- including the ones that declare textures and samplers, which the compiler
# library refused by name until it grew them. The point of running all of them is that ir3
# does not share softpipe's limits: on this machine 40 of them stop inside nir_to_tgsi, so
# the Adreno is the only place the question "does this compile and run" can be asked.
#
# Each in its own process, so one crash costs one kernel. The test binds eight buffers, eight
# 64x64 RGBA8Unorm textures and eight default samplers; a kernel that wants another format or
# another shape is refused by the library with a sentence naming what it wanted, which is the
# measurement this list is for.
/hackios/bin/metal_drv_test /System/Library/CoreImage/PortraitFilters.cifilter/default.metallib MetalFaceMask_Clear
/hackios/bin/metal_drv_test /System/Library/CoreImage/PortraitFilters.cifilter/default.metallib MetalFaceMask_InitMinMax
/hackios/bin/metal_drv_test /System/Library/CoreImage/PortraitFilters.cifilter/default.metallib MetalFaceMask_MinMax
/hackios/bin/metal_drv_test /System/Library/CoreImage/PortraitFilters.cifilter/default.metallib MetalFaceMask_CalcCubeInputScaling
/hackios/bin/metal_drv_test /System/Library/CoreImage/PortraitFilters.cifilter/default.metallib MetalFaceMask_PopulateCube
/hackios/bin/metal_drv_test /System/Library/CoreImage/PortraitFilters.cifilter/default.metallib MetalFaceMask_DilateCubeLuma
/hackios/bin/metal_drv_test /System/Library/CoreImage/PortraitFilters.cifilter/default.metallib MetalFaceMask_DilateCubeChroma1
/hackios/bin/metal_drv_test /System/Library/CoreImage/PortraitFilters.cifilter/default.metallib MetalFaceMask_DilateCubeChroma2
